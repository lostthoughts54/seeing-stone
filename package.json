{
  "name": "localfirst-jellyfin",
  "productName": "LocalFirst Jellyfin",
  "version": "0.4.0",
  "private": true,
  "description": "A Windows-first, local-file-first Jellyfin client.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "clean": "node scripts/clean.mjs",
    "start": "electron .",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run test:core",
    "test:unit": "vitest run",
    "test:core": "pnpm run build:main && node --test tests-node/*.test.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "43.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
