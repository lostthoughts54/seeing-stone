<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>SeeingStone.YouTubeRooms</AssemblyName>
    <RootNamespace>SeeingStone.YouTubeRooms</RootNamespace>
    <Version>2.1.0</Version>
    <Description>Seeing Stone Player Features: persistent watch rooms, readiness, subtitles, chat and YouTube coordination.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11"><ExcludeAssets>runtime</ExcludeAssets></PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11"><ExcludeAssets>runtime</ExcludeAssets></PackageReference>
  </ItemGroup>
</Project>
